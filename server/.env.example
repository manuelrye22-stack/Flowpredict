# Copy this to .env and fill in your values

# MongoDB Connection
MONGODB_URI=mongodb+srv://your-mongodb-uri

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Server Port
PORT=3001

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# ===================
# CRYPTO WALLET SETUP
# ===================

# Platform TRC-20 USDT receiving address
PLATFORM_WALLET=TDPxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TronGrid API Key (REQUIRED for auto-deposit detection)
# Get free at: https://trongrid.io
# Sign up → Dashboard → API Key
TRONGRID_API_KEY=your_trongrid_api_key_here

# ===================
# OPTIONAL SETUP
# ===================

# CoinGecko API (for crypto price verification)
# Get free at: https://www.coingecko.com/api
COINGECKO_API_KEY=your_coingecko_api_key

# Open-Meteo API (for weather verification) - FREE, no key needed
# Just configure in verificationService.ts